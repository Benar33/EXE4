* {
    font-family: "Segoe UI", "Consolas";
    outline: none;
}

/* CHART_COLORS
chart-background: #111827
chart-plot: #0f172a
chart-grid: #334155
chart-tick: #94a3b8
chart-title: #dbeafe
chart-axis-label: #93c5fd
chart-original: #3b82f6
chart-original-edge: #93c5fd
chart-corrected: #38bdf8
chart-corrected-edge: #bae6fd
chart-original-average: #60a5fa
chart-corrected-average: #bae6fd
chart-legend-background: #111827
chart-legend-border: #334155
chart-legend-text: #dbeafe
*/

QWidget {
    background-color: #0b1120;
    color: #dbeafe;
    font-size: 14px;
}

QLabel {
    color: #dbeafe;
}

QFrame#card {
    background-color: #111827;
    border: 1px solid #263244;
    border-radius: 14px;
}

QLabel#appTitle {
    color: #f8fafc;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 1px;
}

QLabel#appSubtitle {
    color: #7dd3fc;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
}

QPushButton {
    background-color: #172033;
    color: #f8fafc;
    border: 1px solid #334155;
    border-radius: 9px;
    padding: 9px 14px;
    font-weight: 600;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #1d4ed8;
    border-color: #60a5fa;
}

QPushButton:pressed {
    background-color: #172554;
}

QPushButton:disabled {
    background-color: #131b2b;
    color: #64748b;
    border-color: #263244;
}

QPushButton#primaryButton {
    background-color: #2563eb;
    border-color: #60a5fa;
}

QPushButton#primaryButton:hover {
    background-color: #3b82f6;
}

QSpinBox {
    background-color: #0c1425;
    color: #e5efff;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 6px 8px;
    min-height: 20px;
    selection-background-color: #2563eb;
}

QSpinBox:focus {
    border: 2px solid #3b82f6;
}

QSpinBox:disabled {
    color: #64748b;
    background-color: #1a2230;
}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 18px;
    border: none;
    background-color: #172033;
}

QTableWidget {
    background-color: #0c1425;
    alternate-background-color: #111a2a;
    border: none;
    gridline-color: #263244;
    selection-background-color: #1d4ed8;
    selection-color: #ffffff;
}

QTableWidget::item {
    padding: 7px;
}

QHeaderView::section {
    background-color: #182238;
    color: #93c5fd;
    border: none;
    border-right: 1px solid #334155;
    border-bottom: 2px solid #3b82f6;
    padding: 10px 6px;
    font-weight: 700;
}

QScrollBar:vertical {
    background: #111827;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #334155;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #3b82f6;
}

QLabel#bonusLabel {
    color: #93c5fd;
    font-weight: 600;
}

QLabel#fileLabel {
    background-color: #0c1425;
    border: 1px solid #263244;
    border-radius: 8px;
    padding: 8px 12px;
    color: #bfdbfe;
}

QLabel#messageLabel {
    background-color: #111827;
    border-left: 3px solid #38bdf8;
    border-radius: 6px;
    padding: 8px 10px;
    color: #7dd3fc;
    font-weight: 600;
}

QLabel#aboutName {
    color: #60a5fa;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: 2px;
}

QLabel#aboutEmail {
    color: #cbd5e1;
    font-size: 13px;
}

QLabel#aboutPicture {
    background-color: #0c1425;
    border: 2px solid #334155;
    border-radius: 12px;
}

QLabel#aboutLink {
    background-color: #1d4ed8;
    color: #ffffff;
    border: 1px solid #60a5fa;
    border-radius: 9px;
    padding: 9px 12px;
    font-size: 16px;
    font-weight: 700;
}
